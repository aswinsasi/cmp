#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/npx" ]; then
  exec "$basedir/npx" tsx "$basedir/../@cmp/cli/src/cli.ts" "$@"
else 
  exec npx tsx "$basedir/../@cmp/cli/src/cli.ts" "$@"
fi
